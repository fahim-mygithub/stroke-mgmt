exports[`EjsAlgorithmRenderer Behavior should render scored algorithm 1`] = `
"<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <style>
  body {
    margin: 0 16px;
    /* CMS authors paste bare URLs as link text (a 118-char Medtronic link in
       the Solitaire procedure demo), and an unbreakable token overflows the
       page. Only breaks words that do not fit. */
    overflow-wrap: break-word;
    padding: 0;
    font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
    background-color: transparent;
    color: #0B1220;
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: #1E4E8C;
  }

  iframe {
    width: 100%;
    max-width: 100%;
  }

  /* A cap, not a used width. \`width: 100%\` upscaled small images past their
     intrinsic size (a 575px asset rendered 830px on a tablet) and was ignored
     in every intrinsic-sizing context — table cells, the flex switch labels,
     and the shrink-to-fit tooltip — where a wide image escaped the page.
     \`height: auto\` also neutralises the \`height\` attribute that
     sanitizeCmsHtml allows through, which would otherwise distort the ratio. */
  img {
    max-width: 100%;
    height: auto;
    border-radius: 10px;
  }

  h1 {
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  h2 {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  h3 {
    font-size: 18px;
    font-weight: 700;
  }

  ul,
  ol {
    padding-left: 22px;
  }

  blockquote {
    position: relative;
    margin: 0;
    padding: 16px 32px;
    border-radius: 0 10px 10px 0;
    background-color: #F3F7FB;
  }

  blockquote::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background-color: #1E4E8C;
  }

  table {
    border-collapse: collapse;
    border-spacing: 0px;
    border-radius: 10px;
  }

  table,
  th,
  td {
    border: 1px solid #E4E7EB;
  }

  thead {
    background-color: #EAF0F8;
  }

  tr {
    height: 56px;
  }

  thead th {
    color: #0B1220;
  }

  td,
  th {
    padding-left: 16px;
    padding-right: 16px;
    text-align: center;
  }

  details summary::-webkit-details-marker,
  ::marker {
    display: none;
  }

  /* Responsive Page Width */

  @media screen and (min-width: 900px) {
    body {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    .template.header,
    .template.main,
    .template.citations {
      width: 868px;
    }
  }

  /* Wrapper */

  .table__wrapper {
    width: 100%;
    overflow-x: scroll;
  }

  /* Template */

  .template {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .template.switches__list,
  .template.outcomes__list {
    list-style: none;
    padding: 0;
  }

  .template.header__title {
    margin: 0;
    padding-top: 16px;
    /* screen title */
    line-height: 1.2;
    font-size: 28px;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  .template.body__paragraph {
    margin-top: 16px;
    /* body-large */
    line-height: 1.7;
    font-size: 16px;
    font-weight: 400;
  }

  .template.switches__list {
    margin-top: 16px;
  }

  .template.switches__list-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 8px;
    user-select: none;
    position: relative;
    /* Flex items default to min-width:auto, so a replaced child's intrinsic
       width would push the row past the viewport instead of shrinking. */
    min-width: 0;
  }

  /* NOT the group label: flooring it at min-content is what keeps a long
     single-word label (Thrombocytopenia, Hyperlipidaemia) from being sliced by
     the level chips, which paint over it. An image in a label is already
     contained by img{max-width:100%}, which transfers into the automatic
     minimum size on its own. */
  .template.switches__radiogroup {
    min-width: 0;
  }

  .template.switches__list-item:first-child {
    padding-top: 0;
  }

  .template.switches__tooltip {
    display: none;
    position: absolute;
    top: 100%;
    /* Absolutely positioned, so shrink-to-fit: without a cap a wide replaced
       child sets the width from its intrinsic size and overflows the page.
       The tooltip is also outside the flow, so it never contributes to
       body.offsetHeight and can never be measured — keep it text-sized. */
    left: 0;
    max-width: 100%;
    box-sizing: border-box;
    background-color: #0B1220;
    color: #FFFFFF;
    padding: 8px 12px;
    border-radius: 10px;
    z-index: 999;
    /* body-small */
    line-height: 16px;
    font-size: 12px;
    letter-spacing: 0.4px;
    font-weight: 400;
  }

  .template.switches__group-label--has-description::after {
    content: 'ⓘ';
    display: inline-block;
    margin-left: 4px;
  }

  .template.switches__tooltip-select {
    height: 0px;
    width: 0px;
    visibility: transparent;
  }

  .template.switches__tooltip-select:checked+.template.switches__tooltip {
    display: block;
  }

  .template.switches__input {
    height: 0px;
    width: 0px;
    visibility: hidden;
  }

  .template.switches__group-label {
    /* title-medium */
    line-height: 24px;
    font-size: 14px;
    font-weight: 600;
    color: #0B1220;
  }

  .template.switches__radio-label {
    /* label-large */
    line-height: 20px;
    font-size: 13px;
    font-weight: 500;
  }

  .template.switches__radiogroup {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 6px;
  }

  .template.switches__level {
    border-radius: 10px;
    border: 1px solid #E4E7EB;
    background-color: #FFFFFF;
    color: #475467;
  }

  .template.switches__level--checked {
    background-color: #1E4E8C;
    border-color: #1E4E8C;
    color: white;
    box-shadow: 0 0 0 3px #EAF0F8;
  }

  .template.switches__radio-label {
    display: inline-block;
    min-width: 44px;
    padding: 8px 14px;
    text-align: center;
  }

  .template.outcomes__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .template.outcomes__headline {
    margin: 0;
    margin-top: 16px;
    /* title-medium */
    line-height: 24px;
    font-size: 16px;
    letter-spacing: -0.01em;
    font-weight: 600;
    color: #0B1220;
  }

  .template.outcomes__list-item {
    margin-top: 10px;
  }

  .template.outcomes__title {
    /* card title */
    line-height: 24px;
    font-size: 15px;
    letter-spacing: -0.005em;
    font-weight: 600;
    color: #0B1220;
  }

  .template.outcomes__item {
    padding: 16px 18px;
    border: 1px solid #E4E7EB;
    border-radius: 10px;
    background-color: #FFFFFF;
  }

  .template.outcomes__item>summary {
    list-style: none;
  }

  .template.outcomes__item[open] {
    border-color: #667085;
    box-shadow: 0 4px 8px -2px rgba(16, 24, 40, .06), 0 2px 4px -2px rgba(16, 24, 40, .04);
  }

  .template.outcomes__item .template.outcomes__title {
    color: #0B1220;
  }

  .template.outcomes__item[open] .template.outcomes__title {
    color: #0B1220;
  }

  .template.outcomes__item--empty {
    background-color: transparent;
    border-style: dashed;
  }

  .template.outcomes__body {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid #EEF0F3;
  }

  .template.outcomes__button {
    background-color: #1E4E8C;
    color: white;
    border-radius: 10px;
    border: 1px solid #1E4E8C;
    height: 40px;
    padding: 0 18px;
    margin-top: 16px;
    /* label-large */
    line-height: 20px;
    font-size: 14px;
    font-weight: 600;
  }

  .iframe__wrapper {
    min-width: 100%;
    min-height: 300px;
  }

  .iframe__wrapper--offline,
  .iframe__wrapper--loading {
    border: 1px dashed #E4E7EB;
    border-radius: 10px;
    position: relative;
  }

  .iframe__wrapper::before {
    text-align: center;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
