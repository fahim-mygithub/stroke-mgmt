<% if(data.algorithm.getOutcomes().length === 0) { %>
<%# A step with no outcomes attached is terminal: the pathway ends here, so %>
<%# offer the same completion affordance a terminal outcome gets. Index -1 %>
<%# resolves to no outcome, so the step is recorded without an outcome title. %>
<button class="template outcomes__button" data-next-id="__finish__:-1">
  Complete &amp; view summary
</button>
<% } else { %>
<ul class="template outcomes__list">
  <h1 class="template outcomes__headline">Results</h1>
  <% if(data.algorithm.hasOutcomes()) { %>
  <% data.algorithm.getDisplayedOutcomes().forEach(function(outcome, i) { %>
  <li class="template outcomes__list-item">
    <details class="template outcomes__item" <%- data.algorithm.getDisplayedOutcomes().length === 1 ? 'open' : '' %>>
      <summary><span class="template outcomes__title"><%- outcome.getTitle() %><span></summary>
      <div class="template outcomes__body"><%- outcome.getBody() %></div>
      <% if(outcome.getNext()) { %>
      <button class="template outcomes__button" data-next-id="<%- outcome.getNext() %>">
        Continue
      </button>
      <% } else if(!outcome.haltsPathway()) { %>
      <%# Terminal outcome: reuse the nextpressed bridge with a sentinel id that %>
      <%# encodes the displayed-outcome index so the app can record the choice %>
      <%# and navigate to the treatment summary. %>
      <button class="template outcomes__button" data-next-id="__finish__:<%- i %>">
        Complete &amp; view summary
      </button>
      <% } %>
      <%# Halt outcomes ("resolve this, then re-assess") get no button. %>
    </details>
  </li>
  <% }) %>
  <% } else { %>
  <%- include('noOutcomesYet') %>
  <% } %>
</ul>
<% } %>
